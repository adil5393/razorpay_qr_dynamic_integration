# Copy to backend/.env and fill in. Never commit the real .env.

# development | test | production
APP_ENV=development

# DATABASE (postgresql:// uses psycopg2, postgresql+psycopg:// uses psycopg 3)
DATABASE_URL=postgresql+psycopg://qruser:change-me@localhost:5432/qrcollections
# Unit tests drop and recreate every table here. Name must end with _test.
TEST_DATABASE_URL=postgresql+psycopg://qruser:change-me@localhost:5432/qrcollections_test
# true only inside the old Emergent preview container
LOCAL_POSTGRES_BOOTSTRAP=false
# Development convenience only. Must be false in production, where `python migrate.py`
# is run as an explicit deployment step (the app then refuses to start on an outdated schema).
RUN_MIGRATIONS_ON_STARTUP=true

# FRONTEND (comma-separate several origins; https in production)
FRONTEND_URL=http://localhost:3000

# AUTHENTICATION
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
COOKIE_SECURE=false

# Reverse proxies whose X-Forwarded-For is trusted (IPs or CIDRs). Empty = trust none.
# Set to exactly the nginx container's network, e.g. 172.18.0.0/16. Never publish the app port publicly.
TRUSTED_PROXIES=

# LOGGING: text | json
LOG_FORMAT=text
LOG_LEVEL=INFO

# INITIAL ADMIN ACCOUNT (created once; never overwrites an existing user)
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# QR COLLECTIONS
QR_EXPIRY_MINUTES=30

# RAZORPAY
# Use rzp_test_ keys outside production. rzp_live_ keys are refused unless APP_ENV=production.
# In production RAZORPAY_EXPECTED_MODE (test|live) is required and must match the key.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_EXPECTED_MODE=test
